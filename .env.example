# SQLite is the no-service local default. Use a PostgreSQL URL when deploying.
DATABASE_URL=sqlite:///data/stylespeak-v2.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to true only after offline semantic embeddings are generated.
SEMANTIC_SEARCH_ENABLED=false
WHISPER_MODEL=tiny.en
